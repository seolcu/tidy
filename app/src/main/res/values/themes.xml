<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the Compose theme's background token
         (ui/theme/Color.kt), so there's no flash of another color at start. -->
    <style name="Theme.Tidy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
