    </plurals>
    <plurals name="home_layout_loose">
        <item quantity="one">%d app outside folders</item>
        <item quantity="other">%d apps outside folders</item>
    </plurals>
    <string name="home_start">Read the apps screen and organize</string>
    <string name="home_start_hint">Tidy opens the apps screen and looks into each folder. Nothing changes until you confirm.</string>
    <string name="home_undo">Undo last organizing</string>
    <string name="home_undo_hint">Back to the folders from before</string>
    <string name="home_undo_forget">Forget it</string>
    <string name="home_undo_confirm_title">Undo?</string>
    <string name="home_undo_confirm_body">Tidy puts the folders back the way they were before the last run. The screen moves by itself for a while; don\'t touch it.</string>

