    <!-- Home -->
    <string name="home_tagline">Sorts One UI\'s apps screen into folders</string>
    <string name="setup_section">Setup</string>
    <string name="setup_body">Tidy organizes the real One UI apps screen by moving icons for you, the way you would by hand. For that it needs an accessibility permission, limited to the One UI home screen.\n\nIn Accessibility settings, open Installed apps and turn on Tidy.</string>
    <string name="setup_open_settings">Open accessibility settings</string>
    <string name="setup_restricted">Switch greyed out? App info → ⋮ → Allow restricted settings</string>
    <string name="home_apps_screen">Apps screen</string>
    <string name="home_not_read">Not read yet</string>
