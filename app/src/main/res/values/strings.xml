    <!-- Accessibility service -->
    <string name="service_label">Tidy</string>
    <string name="service_summary">Organizes the One UI apps screen into folders</string>
    <string name="service_description">Tidy opens the One UI apps screen, reads its folders and moves icons into folders for you, only when you ask it to or when you add a new app to a folder. It works only on the One UI home screen and doesn\'t read other apps.</string>

