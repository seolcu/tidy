    <!-- 홈 -->
    <string name="home_tagline">One UI 앱스 화면을 폴더로 정리</string>
    <string name="setup_section">준비</string>
    <string name="setup_body">Tidy는 진짜 One UI 앱스 화면에서 아이콘을 직접 옮겨서 정리해요. 손으로 하는 것과 같은 방식이라 접근성 권한이 필요하고, One UI 홈 화면에서만 써요.\n\n접근성 설정 → 설치된 앱 → Tidy를 켜 주세요.</string>
    <string name="setup_open_settings">접근성 설정 열기</string>
    <string name="setup_restricted">스위치가 회색이면: 앱 정보 → ⋮ → 제한된 설정 허용</string>
    <string name="home_apps_screen">앱스 화면</string>
    <string name="home_not_read">아직 읽지 않음</string>
    <plurals name="home_layout_folders">
        <item quantity="other">폴더 %d개</item>
    </plurals>
    <plurals name="home_layout_loose">
        <item quantity="other">폴더 밖 앱 %d개</item>
    </plurals>
    <string name="home_start">앱스 화면 읽고 정리하기</string>
    <string name="home_start_hint">앱스 화면을 열어 폴더 안까지 확인해요. 직접 확인하기 전에는 아무것도 바꾸지 않아요.</string>
    <string name="home_undo">마지막 정리 되돌리기</string>
    <string name="home_undo_hint">정리하기 전 폴더 구성으로</string>
    <string name="home_undo_confirm_title">되돌릴까요?</string>
    <string name="home_undo_confirm_body">마지막으로 정리하기 전의 폴더 구성으로 되돌려요. 한동안 화면이 혼자 움직이니 만지지 말아 주세요.</string>

    <string name="work_reading">앱스 화면 읽는 중…</string>
